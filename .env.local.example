NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Sinkron omzet POS (Silang-Cek Omzet Resto) -- SEMUA RAHASIA, hanya server ───
# Diisi di Vercel (Production). Route: /api/sinkron/pos. Penjadwal BELUM dipasang.
# Rahasia untuk memanggil /api/sinkron/pos (Vercel Cron mengirimnya otomatis sebagai
# "Authorization: Bearer <nilai ini>"). Min. 16 karakter acak; kosong = route mati (503).
CRON_SECRET=
# Alamat dasar pos-fnb (tanpa garis miring akhir), mis. https://pos-fnb.<akun>.workers.dev
POS_INTEGRASI_URL=
# Token Bearer yang SAMA dengan INTEGRASI_LAPORAN_TOKEN di pos-fnb (min. 32 karakter).
POS_INTEGRASI_TOKEN=

# ─── Handoff satu pintu masuk ke dashboard pos-fnb (25 September 2026) ───
# Route: /api/pos-handoff. Nilai SAMA PERSIS dengan POS_HANDOFF_SECRET di
# pos-fnb (env server-only di sana juga, BUKAN NEXT_PUBLIC_). Rahasia --
# produksi: env var Vercel (Production). Min. 32 karakter acak (mis.
# `openssl rand -base64 48`). Token yang ditandatangani cuma membawa email
# + kedaluwarsa 60 detik -- BUKAN role/outlet, lihat lib/posHandoff.ts.
POS_HANDOFF_SECRET=
